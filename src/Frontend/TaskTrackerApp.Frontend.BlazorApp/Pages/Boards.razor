@page "/boards"
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]

<PageTitle>Boards</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-8 mb-16">

    @if (isLoading)
    {
        <div class="d-flex justify-center mt-16">
            <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
        </div>
    }
    else
    {
        @if (HasLockedBoards)
        {
            <MudAlert Severity="Severity.Warning" Variant="Variant.Filled" Class="mb-6" Icon="@Icons.Material.Filled.Lock">
                You have reached the free limit of 3 boards. Some boards are now read-only.
                <MudButton Variant="Variant.Text" Color="Color.Inherit" OnClick="NavigateToUpgrade" Class="ml-2 fw-bold" Style="text-decoration:underline;">
                    Upgrade to Pro to unlock
                </MudButton>
            </MudAlert>
        }

        @* SECTION 1: Last Opened *@
        @if (lastOpenedBoards.Any())
        {
            <MudText Typo="Typo.h5" Class="mb-4 fw-bold">
                <MudIcon Icon="@Icons.Material.Filled.AccessTime" Class="mr-2 mb-n1" />
                Last Opened
            </MudText>
            <MudGrid Class="mb-8">
                @foreach (var board in lastOpenedBoards)
                {
                    <MudItem xs="12" sm="6" md="3">
                        <MudCard Elevation="3" Class="@GetBoardCardClass(board.IsLocked)" @onclick="@(() => HandleBoardClick(board.Id))">
                            <MudCardContent>
                                <div class="d-flex justify-space-between">
                                    <MudText Typo="Typo.h6">@board.Title</MudText>
                                    @if (board.IsLocked)
                                    {
                                        <MudIcon Icon="@Icons.Material.Filled.Lock" Color="Color.Error" Size="Size.Small" />
                                    }
                                </div>
                                <MudText Typo="Typo.caption">Last opened: @board.LastModified.ToShortDateString()</MudText>
                            </MudCardContent>
                        </MudCard>
                    </MudItem>
                }
            </MudGrid>
        }

        @* SECTION 2: Starred Boards *@
        @if (StarredBoards.Any())
        {
            <MudText Typo="Typo.h5" Class="mb-4 fw-bold">
                <MudIcon Icon="@Icons.Material.Filled.Star" Color="Color.Warning" Class="mr-2 mb-n1" />
                Starred Boards
            </MudText>
            <MudGrid Class="mb-8">
                @foreach (var board in StarredBoards)
                {
                    <MudItem xs="12" sm="6" md="4">
                        <MudCard Elevation="2" Class="@GetBoardCardClass(board.IsLocked)" @onclick="@(() => HandleBoardClick(board.Id))">
                            <MudCardHeader>
                                <CardHeaderContent>
                                    <div class="d-flex justify-space-between align-center">
                                        <div class="d-flex align-center gap-2">
                                            <MudText Typo="Typo.h6">@board.Title</MudText>

                                            @if (board.CreatedById == _currentUserId)
                                            {
                                                <MudTooltip Text="Owned by you" Placement="Placement.Top">
                                                    <MudIcon Icon="@Icons.Material.Filled.Person" Size="Size.Small" Class="mud-text-secondary" />
                                                </MudTooltip>
                                            }
                                            else
                                            {
                                                <MudTooltip Text="Shared with you" Placement="Placement.Top">
                                                    <MudIcon Icon="@Icons.Material.Filled.PeopleAlt" Size="Size.Small" Class="mud-text-secondary" />
                                                </MudTooltip>
                                            }
                                        </div>

                                        <div class="d-flex align-center">
                                            @if (board.IsLocked)
                                            {
                                                <MudIcon Icon="@Icons.Material.Filled.Lock" Color="Color.Error" Size="Size.Small" Class="mr-2" />
                                            }
                                            <MudIconButton Icon="@Icons.Material.Filled.Star"
                                                           Color="Color.Warning"
                                                           Size="Size.Small"
                                                           OnClick="@(() => ToggleBoardStar(board))"
                                                           OnClickStopPropagation="true" />
                                        </div>
                                    </div>
                                </CardHeaderContent>
                            </MudCardHeader>
                            <MudCardContent Class="pb-4">
                                <MudText Typo="Typo.body2" Class="text-secondary">@board.Description</MudText>
                            </MudCardContent>
                        </MudCard>
                    </MudItem>
                }
            </MudGrid>
        }

        @* SECTION 3: My Workspaces (Owned Boards) *@
        <div class="d-flex justify-space-between align-center mb-4">
            <MudText Typo="Typo.h5" Class="fw-bold">
                <MudIcon Icon="@Icons.Material.Filled.Person" Class="mr-2 mb-n1" />
                My Workspaces
            </MudText>
            <MudButton Variant="Variant.Filled" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.Add" OnClick="HandleCreateBoard">
                Create New Board
            </MudButton>
        </div>

        <MudGrid Class="mb-8">
            @if (!OwnedBoards.Any() && !StarredBoards.Any())
            {
                <MudItem xs="12">
                    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">You don't own any boards yet.</MudAlert>
                </MudItem>
            }
            @foreach (var board in OwnedBoards)
            {
                <MudItem xs="12" sm="6" md="4">
                    <MudCard Elevation="2" Class="@GetBoardCardClass(board.IsLocked)" @onclick="@(() => HandleBoardClick(board.Id))">
                        <MudCardHeader>
                            <CardHeaderContent>
                                <div class="d-flex justify-space-between align-center">
                                    <MudText Typo="Typo.h6">@board.Title</MudText>
                                    <div class="d-flex align-center">
                                        @if (board.IsLocked)
                                        {
                                            <MudIcon Icon="@Icons.Material.Filled.Lock" Color="Color.Error" Size="Size.Small" Class="mr-2" />
                                        }
                                        <MudIconButton Icon="@Icons.Material.Outlined.StarOutline" Color="Color.Default" Size="Size.Small" OnClick="@(() => ToggleBoardStar(board))" OnClickStopPropagation="true" />
                                    </div>
                                </div>
                            </CardHeaderContent>
                        </MudCardHeader>
                        <MudCardContent Class="pb-4">
                            <MudText Typo="Typo.body2" Class="text-secondary">@board.Description</MudText>
                        </MudCardContent>
                    </MudCard>
                </MudItem>
            }
        </MudGrid>

        @* SECTION 4: Shared With Me *@
        @if (SharedBoards.Any())
        {
            <MudText Typo="Typo.h5" Class="mb-4 fw-bold">
                <MudIcon Icon="@Icons.Material.Filled.PeopleAlt" Class="mr-2 mb-n1" />
                Shared With Me
            </MudText>
            <MudGrid>
                @foreach (var board in SharedBoards)
                {
                    <MudItem xs="12" sm="6" md="4">
                        <MudCard Elevation="2" Class="@GetBoardCardClass(board.IsLocked)" @onclick="@(() => HandleBoardClick(board.Id))">
                            <MudCardHeader>
                                <CardHeaderContent>
                                    <div class="d-flex justify-space-between align-center">
                                        <MudText Typo="Typo.h6">@board.Title</MudText>
                                        <div class="d-flex align-center">
                                            @if (board.IsLocked)
                                            {
                                                <MudIcon Icon="@Icons.Material.Filled.Lock" Color="Color.Error" Size="Size.Small" Class="mr-2" />
                                            }
                                            <MudIconButton Icon="@Icons.Material.Outlined.StarOutline" Color="Color.Default" Size="Size.Small" OnClick="@(() => ToggleBoardStar(board))" OnClickStopPropagation="true" />
                                        </div>
                                    </div>
                                </CardHeaderContent>
                            </MudCardHeader>
                            <MudCardContent Class="pb-4">
                                <MudText Typo="Typo.body2" Class="text-secondary">@board.Description</MudText>
                            </MudCardContent>
                        </MudCard>
                    </MudItem>
                }
            </MudGrid>
        }
    }
</MudContainer>