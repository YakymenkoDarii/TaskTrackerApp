@page "/board/{BoardId:int}"
@using TaskTrackerApp.Frontend.BlazorApp.Components
@using TaskTrackerApp.Frontend.BlazorApp.Components.Cards
@using TaskTrackerApp.Frontend.BlazorApp.Components.Column
@using TaskTrackerApp.Frontend.Domain.DTOs.Boards
@using TaskTrackerApp.Frontend.Domain.DTOs.Columns
@using TaskTrackerApp.Frontend.Domain.DTOs.Cards
@using TaskTrackerApp.Frontend.Services.Abstraction.Interfaces.Services

<PageTitle>@(board?.Title ?? "Loading...")</PageTitle>

@if (isLoading)
{
    <MudContainer Class="d-flex justify-center align-center" Style="height: 80vh;">
        <MudProgressCircular Color=@Color.Info Indeterminate=@true />
    </MudContainer>
}
else if (board == null)
{
    <MudAlert Severity=@Severity.Error>Board not found.</MudAlert>
}
else
{
    @if (board.IsLocked)
    {
        <MudAlert Severity="Severity.Warning" Variant="Variant.Filled" Square="true" Class="mb-0" Icon="@Icons.Material.Filled.Lock">
            <b>Read-Only Mode:</b> The owner of this board has reached their free plan limit. 
            <MudLink OnClick="NavigateToUpgrade" Color="Color.Inherit" Underline="Underline.Always" Class="ml-2 cursor-pointer fw-bold">
                Upgrade to Pro to unlock editing.
            </MudLink>
        </MudAlert>
    }

    @if (IsInMeeting)
    {
        <div class="meet-overlay" style="@(IsMinimized ? "display:none;" : "")">
            <div class="meet-header d-flex justify-space-between align-center">
                <MudText Typo="Typo.h6" Style="color:white;">@board.Title - Meeting</MudText>
                <MudIconButton Icon="@Icons.Material.Filled.Minimize" Color="Color.Inherit" OnClick="@(() => IsMinimized = true)" />
            </div>

            @if (IncomingScreens.Any())
            {
                <div class="meet-screenshare-grid" style="width:100%; display:flex; gap:10px; margin-bottom:20px; overflow-x:auto;">
                    @foreach (var screen in IncomingScreens)
                    {
                        <div class="meet-screenshare-card">
                            <video id="screen-@screen.PeerId" autoplay playsinline muted></video>
                            <div class="meet-name-tag">
                                <MudIcon Icon="@Icons.Material.Filled.ScreenShare" Size="Size.Small" Class="mr-1" />
                                @screen.DisplayName
                            </div>
                        </div>
                    }
                </div>
            }

            <div class="meet-grid">
                <div class="meet-video-card">
                    <div class="meet-avatar-overlay">
                        <MudAvatar Color="Color.Secondary" Style="height:80px; width:80px; font-size:2rem;">
                            @if (MainLayout != null && !string.IsNullOrEmpty(MainLayout.UserAvatarUrl))
                            {
                                <MudImage Src="@MainLayout.UserAvatarUrl" />
                            }
                            else
                            {
                                @((MainLayout?.UserDisplayName ?? "Y").Substring(0, 1).ToUpper())
                            }
                        </MudAvatar>
                    </div>

                    <video id="localVideo" autoplay muted playsinline
                           class="meet-video @(IsVideoOff ? "hidden" : "")"></video>

                    <div class="meet-name-tag">
                        @if (IsMuted)
                        {
                            <MudIcon Icon="@Icons.Material.Filled.MicOff" Size="Size.Small" Color="Color.Error" Class="mr-1" />
                        }
                        @(MainLayout?.UserDisplayName ?? "You")
                    </div>
                </div>

                @foreach (var user in RemoteParticipants)
                {
                    <div class="meet-video-card">
                        <div class="meet-avatar-overlay">
                            <MudAvatar Color="Color.Primary" Style="height:80px; width:80px; font-size:2rem;">
                                @if (!string.IsNullOrEmpty(user.AvatarUrl))
                                {
                                    <MudImage Src="@user.AvatarUrl" />
                                }
                                else
                                {
                                    @(user.DisplayName?.Substring(0, 1).ToUpper() ?? "?")
                                }
                            </MudAvatar>
                        </div>

                        <video id="video-@user.PeerId" autoplay playsinline
                               class="meet-video @(user.IsVideoOff ? "hidden" : "")"></video>

                        <div class="meet-name-tag">
                            @if (user.IsMuted)
                            {
                                <MudIcon Icon="@Icons.Material.Filled.MicOff" Size="Size.Small" Color="Color.Error" Class="mr-1" />
                            }
                            @user.DisplayName
                        </div>
                    </div>
                }
            </div>

            <div class="meet-controls">
                <button class="meet-btn @(IsMuted ? "active" : "")" @onclick="ToggleMute">
                    <MudIcon Icon="@(IsMuted? Icons.Material.Filled.MicOff : Icons.Material.Filled.Mic)" />
                </button>
                <button class="meet-btn @(IsVideoOff ? "active" : "")" @onclick="ToggleCamera">
                    <MudIcon Icon="@(IsVideoOff? Icons.Material.Filled.VideocamOff : Icons.Material.Filled.Videocam)" />
                </button>

                <MudMenu Icon="@Icons.Material.Filled.Settings"
                         Variant="Variant.Filled"
                         AnchorOrigin="Origin.TopCenter"
                         TransformOrigin="Origin.BottomCenter"
                         Class="meet-btn-settings">

                    <ActivatorContent>
                        <button class="meet-btn" @onclick="OpenSettings">
                            <MudIcon Icon="@Icons.Material.Filled.Settings" />
                        </button>
                    </ActivatorContent>

                    <ChildContent>
                        <MudPaper Class="pa-3" Style="width: 300px;">
                            <MudText Typo="Typo.subtitle2" Class="mb-2">Microphone</MudText>
                            <MudSelect T="string" Value="@SelectedAudioId" ValueChanged="OnAudioDeviceChanged" Dense="true" Margin="Margin.Dense" Variant="Variant.Outlined">
                                @foreach (var dev in AudioDevices)
                                {
                                    <MudSelectItem Value="@dev.DeviceId">@dev.Label</MudSelectItem>
                                }
                            </MudSelect>

                            <MudText Typo="Typo.subtitle2" Class="mt-3 mb-2">Camera</MudText>
                            <MudSelect T="string" Value="@SelectedVideoId" ValueChanged="OnVideoDeviceChanged" Dense="true" Margin="Margin.Dense" Variant="Variant.Outlined">
                                @foreach (var dev in VideoDevices)
                                {
                                    <MudSelectItem Value="@dev.DeviceId">@dev.Label</MudSelectItem>
                                }
                            </MudSelect>
                        </MudPaper>
                    </ChildContent>
                </MudMenu>

                <button class="meet-btn @(IsScreenSharing ? "screen-active" : "")" @onclick="ToggleScreenShare">
                    <MudIcon Icon="@(IsScreenSharing? Icons.Material.Filled.StopScreenShare : Icons.Material.Filled.ScreenShare)" />
                </button>
                <button class="meet-btn active" style="background-color: #ea4335; width: 60px; border-radius: 20px;" @onclick="LeaveMeeting">
                    <MudIcon Icon="@Icons.Material.Filled.CallEnd" />
                </button>
            </div>
        </div>

   
        @if (IsMinimized)
        {
            <MudPaper Class="pa-3 d-flex align-center gap-4 mud-theme-dark"
                      Style="position:fixed; bottom:20px; right:20px; z-index:2000; border: 1px solid #444;"
                      Elevation="10">
                <MudIcon Icon="@Icons.Material.Filled.Videocam" Color="Color.Success" />
                <div>
                    <MudText Typo="Typo.subtitle2" Color="Color.Success">Meeting Active</MudText>
                    <MudText Typo="Typo.caption">@RemoteParticipants.Count others</MudText>
                </div>
                <MudTooltip Text="Maximize">
                    <MudIconButton Icon="@Icons.Material.Filled.OpenInFull" Color="Color.Inherit" OnClick="@(() => IsMinimized = false)" />
                </MudTooltip>
                <MudTooltip Text="Leave">
                    <MudIconButton Icon="@Icons.Material.Filled.CallEnd" Color="Color.Error" OnClick="LeaveMeeting" />
                </MudTooltip>
            </MudPaper>
        }
    }

    <div class="board-container d-flex flex-column h-100">

        <div class="board-header px-4 py-3 d-flex align-center justify-space-between flex-shrink-0">
            <div style="min-width: 200px;">
                @if (IsAdmin && !board.IsLocked)
                {
                    <EditableLabel @bind-Value="board.Title"
                                   OnCommit="UpdateBoardDetails"
                                   Typo="Typo.h5"
                                   Style="color: white; text-shadow: 1px 1px 2px rgba(0,0,0,0.6); font-weight: bold;" />

                    <EditableLabel @bind-Value="board.Description"
                                   OnCommit="UpdateBoardDetails"
                                   Typo="Typo.body2"
                                   Multiline="true"
                                   Placeholder=""
                                   Style="color: rgba(255, 255, 255, 0.9); text-shadow: 0px 0px 2px black;" />
                }
                else
                {
                    <MudText Typo="Typo.h5" Style="color: white; text-shadow: 1px 1px 2px rgba(0,0,0,0.6); font-weight: bold;">
                        @board.Title
                    </MudText>
                    <MudText Typo="Typo.body2" Style="color: rgba(255, 255, 255, 0.9); text-shadow: 0px 0px 2px black;">
                        @board.Description
                    </MudText>
                }
            </div>

            <div class="d-flex align-center gap-4">

                @if (!IsInMeeting)
                {
                    @if (CurrentMeeting != null && CurrentMeeting.Participants.Any())
                    {
                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Success"
                                   Size="Size.Small"
                                   OnClick="StartMeeting"
                                   StartIcon="@Icons.Material.Filled.Login">
                            Join Call (@CurrentMeeting.Participants.Count) • <MeetingTimer StartTime="@CurrentMeeting.StartTime" />
                        </MudButton>
                    }
                    else
                    {
                        <MudButton Variant="Variant.Outlined" 
                                   Style="color: white; border-color: rgba(255,255,255,0.5);"
                                   Size="Size.Small"
                                   OnClick="StartMeeting" 
                                   StartIcon="@Icons.Material.Filled.VideoCall">
                            Start Call
                        </MudButton>
                    }
                }

                <div style="width: 250px;">
                    <TaskSearch BoardId="@BoardId"
                                Placeholder="Search..."
                                OnTaskChanged="@LoadBoardDataAsync" />
                </div>

                <MudMenu Icon="@Icons.Material.Filled.MoreVert"
                         Color="Color.Inherit"
                         Style="color: white; filter: drop-shadow(0px 0px 2px rgba(0,0,0,0.5));"
                         AnchorOrigin="Origin.BottomRight"
                         TransformOrigin="Origin.TopRight">

                    <MudMenuItem Icon="@Icons.Material.Filled.PeopleAlt"
                                 OnClick="OpenShareDialog">
                        Members
                    </MudMenuItem>

                    @if (CanEditContent)
                    {
                        <MudMenuItem Icon="@(_isLayoutMode? Icons.Material.Filled.Check : Icons.Material.Filled.ViewQuilt)"
                                     OnClick="@(() => _isLayoutMode = !_isLayoutMode)">
                            <div class="d-flex justify-space-between align-center">
                                <MudText>Edit Layout</MudText>
                                <MudSwitch Value="@_isLayoutMode" Color="Color.Success" ReadOnly="true" Class="ml-3" Size="Size.Small" />
                            </div>
                        </MudMenuItem>
                    }

                    <MudDivider />

                    @if (IsAdmin)
                    {
                        <MudMenuItem Icon="@Icons.Material.Filled.Archive"
                                     IconColor="Color.Error"
                                     OnClick="HandleArchiveBoard">
                            Archive Board
                        </MudMenuItem>
                    }
                </MudMenu>
            </div>
        </div>

        <div class="flex-grow-1 overflow-hidden" style="position:relative;">

            @if (_isLayoutMode && CanEditContent)
            {
                <MudDropContainer T=@ColumnDto
                                  @ref=@_columnDropContainer
                                  Items=@columns
                                  ItemsSelector=@((item,dropzone) => true)
                                  ItemDropped=@ColumnDropped
                                  Class="board-canvas d-flex h-100 overflow-auto px-4 pb-4">
                    <ChildContent>
                        <MudDropZone T="ColumnDto"
                            Identifier="board-zone"
                            Class="d-flex gap-4 h-100"
                            AllowReorder="@CanEditContent" />
                    </ChildContent>

                    <ItemRenderer>
                        <div @key="@context.Id" class="board-column">
                            <MudPaper Class="column-paper pa-4 d-flex align-center justify-center cursor-move mud-theme-info"
                                      Elevation=4
                                      Style="height: 100px; opacity: 1.0; color: white;">
                                <MudIcon Icon=@Icons.Material.Filled.DragIndicator Class="mr-2" />
                                <MudText Typo=@Typo.h6>@context.Title</MudText>
                            </MudPaper>
                        </div>
                    </ItemRenderer>
                </MudDropContainer>
            }
            else
            {
                <MudDropContainer T=@CardDto
                                  @ref=@_cardDropContainer
                                  Items=@_allCards
                                  ItemsSelector=@((item, zone) => item.ColumnId.ToString() == zone)
                                  ItemDropped=@CardDropped
                                  Class="board-canvas d-flex h-100 overflow-auto px-4 pb-4 gap-4">
                    <ChildContent>
                        @foreach (var col in columns)
                        {
                            <div class="board-column">
                                <MudPaper Class="column-paper pa-2 d-flex flex-column"
                                          Elevation=2
                                          Style="max-height: 100%; background-color: #f0f2f5;">

                                    <div class="d-flex justify-space-between align-center mb-2 px-2">
                                        <div class="d-flex align-center flex-grow-1 gap-2" style="min-width: 0;">
                                            @if (CanEditContent)
                                            {
                                                <EditableLabel Value=@col.Title
                                                               ValueChanged="@((val) => col.Title = val)"
                                                               OnCommit="@(() => SaveColumn(col))"
                                                               Typo="Typo.subtitle1"
                                                               Style="font-weight: 700; color: #424242; white-space: nowrap;" />

                                                <EditableLabel Value=@col.Description
                                                               ValueChanged="@((val) => col.Description = val)"
                                                               OnCommit="@(() => SaveColumn(col))"
                                                               Typo="Typo.body2"
                                                               Placeholder=" "
                                                               Multiline="false"
                                                               Style="color: #757575; font-style: italic; min-width: 50px;" />
                                            }
                                            else
                                            {
                                                <MudText Typo="Typo.subtitle1" Style="font-weight: 700; color: #424242; white-space: nowrap;">
                                                    @col.Title
                                                </MudText>

                                                @if (!string.IsNullOrEmpty(col.Description))
                                                {
                                                    <MudText Typo="Typo.body2" Style="color: #757575; font-style: italic;">
                                                        @col.Description
                                                    </MudText>
                                                }
                                            }
                                        </div>

                                        @if (CanEditContent)
                                        {
                                            <MudMenu Icon=@Icons.Material.Filled.MoreHoriz Size=@Size.Small>
                                                <MudMenuItem Icon=@Icons.Material.Filled.Delete
                                                             IconColor=@Color.Error
                                                             OnClick=@(() => HandleDeleteColumn(col.Id))>
                                                    Delete List
                                                </MudMenuItem>
                                            </MudMenu>
                                        }
                                    </div>

                                    <MudDropZone T="CardDto"
                                                 Identifier="@col.Id.ToString()"
                                                 Class="task-list mb-2 px-1 flex-grow-1 overflow-auto"
                                                 Style="min-height: 50px;"
                                                 AllowReorder="@CanEditContent" />

                                    @if (CanEditContent)
                                    {
                                    @if (_activeColumnIdForNewCard == col.Id)
                                    {
                                        <CreateCardInline 
                                            OnSubmit="@(async (dto) => await HandleAddCardSubmit(col.Id, dto))" 
                                            OnCancel="HideAddCardInline" />
                                    }
                                    else
                                    {
                                        <MudButton StartIcon=@Icons.Material.Filled.Add
                                                   FullWidth=@true
                                                   Variant=@Variant.Text
                                                   Color=@Color.Dark
                                                   OnClick=@(() => ShowAddCardInline(col.Id))>
                                            Add a task
                                        </MudButton>
                                    }
                                    }
                                </MudPaper>
                            </div>
                        }

                        @if (CanEditContent)
                        {
                            <div class="board-column px-4">
                                @if (_isAddingColumn)
                                {
                                    <CreateColumnInline 
                                        OnSubmit="HandleAddColumnSubmit" 
                                        OnCancel="HideAddColumnInline" />
                                }
                                else
                                {
                                    <MudButton Variant=@Variant.Filled
                                               Color=@Color.Success
                                               OnClick=@ShowAddColumnInline
                                               Class="py-2 fw-bold text-white w-100">
                                        @(columns.Any() ? "Add another list" : "Add list")
                                    </MudButton>
                                }
                            </div>
                        }
                    </ChildContent>

                    <ItemRenderer>
                        <MudCard @key=@context.Id
                                 Class=@($"mb-2 hover-effect {(CanEditContent ? "cursor-move" : "cursor-pointer")} {(IsOverdue(context) ? "border-solid border-2 mud-border-error" : "")}")
                                 Elevation=1
                                 onclick=@(() => HandleCardClick(context))>
                            <MudCardContent Class="pa-2">
                                <div class="d-flex align-center gap-2">
                                    <div @onclick:stopPropagation>
                                        <MudIconButton Icon="@(context.IsCompleted? Icons.Material.Filled.CheckCircle : Icons.Material.Outlined.Circle)"
                                                       Color="@(context.IsCompleted ? Color.Success : GetPriorityColor(context.Priority))"
                                                       Size="Size.Small"
                                                       Disabled="@(!CanEditContent)"
                                                       OnClick="@(() => HandleToggleComplete(context))" />
                                    </div>

                                    <MudText Typo=@Typo.body2
                                             Class="fw-bold flex-grow-1"
                                             Style=@(context.IsCompleted ? "text-decoration: line-through; color: gray;" : "")>
                                        @context.Title
                                    </MudText>
                                </div>

                                @if (!string.IsNullOrWhiteSpace(context.Description))
                                {
                                    <MudText Typo=@Typo.caption
                                             Class="d-block mud-text-secondary mt-1 text-truncate pl-10"
                                             Style=@(context.IsCompleted ? "text-decoration: line-through;" : "")>
                                        @context.Description
                                    </MudText>
                                }

                                @if (context.DueDate.HasValue)
                                {
                                    <div class="d-flex align-center gap-1 mt-2 pl-9">
                                        <MudIcon Icon=@Icons.Material.Filled.Schedule
                                                 Size=@Size.Small
                                                 Color=@(IsOverdue(context) ? Color.Error : Color.Default)
                                                 Style="font-size: 0.8rem;" />

                                        <MudText Typo=@Typo.caption
                                                 Color=@(IsOverdue(context) ? Color.Error : Color.Default)>
                                            @context.DueDate.Value.ToString("MMM dd")
                                        </MudText>
                                    </div>
                                }
                            </MudCardContent>
                        </MudCard>
                    </ItemRenderer>
                </MudDropContainer>
            }
        </div>
    </div>
}