@using TaskTrackerApp.Frontend.Domain.DTOs.Boards
@using TaskTrackerApp.Frontend.Domain.Enums
@using MudBlazor
@using Microsoft.AspNetCore.Components.Web
@using TaskTrackerApp.Frontend.Services.Helpers

<MudDialog>
    <DialogContent>
        <MudTextField T=@string
                      Label="Board Title"
                      @bind-Value=@model.Title
                      Required=@true
                      RequiredError="Title is required!"
                      Immediate=@true
                      OnKeyDown=@HandleKeyDown />

        <MudTextField T=@string
                      Label="Description"
                      @bind-Value=@model.Description
                      Lines=3
                      Class="mt-3" />

        <MudText Typo="Typo.subtitle2" Class="mt-5 mb-2 fw-bold" Style="color: #44546f;">
            Board Theme
        </MudText>
        <div class="d-flex gap-3 flex-wrap">
            @foreach (var color in Enum.GetValues<BoardThemeColor>())
            {
                var hex = BoardHex.GetThemeHex(color);
                var isSelected = model.ThemeColor == color;

                <div @onclick="@(() => SelectColor(color))"
                     class="hover-effect"
                     style="@($"background-color: {hex}; width: 36px; height: 36px; border-radius: 6px; cursor: pointer; display: flex; align-items: center; justify-content: center; transition: all 0.2s; {(isSelected ? "outline: 3px solid #264575; outline-offset: 2px;" : "")}")">
                    @if (isSelected)
                    {
                        <MudIcon Icon="@Icons.Material.Filled.Check" Size="Size.Small" Style="color: white; filter: drop-shadow(0px 1px 1px rgba(0,0,0,0.5));" />
                    }
                </div>
            }
        </div>
    </DialogContent>

    <DialogActions>
        <MudButton OnClick=@Cancel>Cancel</MudButton>

        <MudButton Color=@Color.Primary
                   Variant=@Variant.Filled
                   OnClick=@Submit>Create</MudButton>
    </DialogActions>
</MudDialog>